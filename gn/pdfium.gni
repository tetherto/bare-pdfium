# Build PDFium as a single static library holding every dependency, with the
# features bare-pdfium exposes.
pdf_is_complete_lib = true
is_component_build = false

# Only enable debug checks in non-release builds.
dcheck_always_on = false

pdf_enable_v8 = false
pdf_enable_xfa = false
pdf_use_skia = false

# Allocate through the system allocator rather than PartitionAlloc, which
# would run alongside the host's own.
pdf_use_partition_alloc = false
