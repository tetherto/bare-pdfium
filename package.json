{
  "name": "bare-pdfium",
  "version": "1.5.5",
  "description": "PDF rasterization, inspection and editing for Bare, backed by PDFium",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./package": "./package.json",
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "types": "./index.d.ts",
  "files": [
    "index.js",
    "lib",
    "index.d.ts",
    "binding.c",
    "binding.js",
    "CMakeLists.txt",
    "DEPS",
    "gn",
    "patches",
    "prebuilds",
    "NOTICE.md"
  ],
  "addon": true,
  "engines": {
    "bare": ">=1.16.0"
  },
  "scripts": {
    "format": "prettier --write . && lunte --fix",
    "lint": "prettier --check . && lunte",
    "test": "brittle-bare --coverage test.js test/compose.js test/hardening.js test/markdown.js test/render.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tetherto/bare-pdfium.git"
  },
  "author": "Tether Inc",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/tetherto/bare-pdfium/issues"
  },
  "homepage": "https://github.com/tetherto/bare-pdfium",
  "prettier": "prettier-config-holepunch",
  "dependencies": {
    "bare-crypto": "^1.15.3",
    "bare-png": "^1.0.9"
  },
  "devDependencies": {
    "bare-fs": "^4.8.2",
    "bare-os": "^3.9.3",
    "bare-path": "^3.1.2",
    "brittle": "^3.4.0",
    "cmake-bare": "^1.9.0",
    "cmake-gn": "^1.0.1",
    "lunte": "^1.8.4",
    "prettier": "^3.3.3",
    "prettier-config-holepunch": "^2.0.0"
  }
}
